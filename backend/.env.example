# Reltio access request backend — environment variables
# Copy to .env and fill in values for your environment.
# run_local.py sets all of these automatically for local development.

# --- Entra (Azure AD) ---
ENTRA_TENANT_ID=<your-lilly-entra-tenant-guid>
ENTRA_API_AUDIENCE=api://<api-app-client-id>

# --- Approvers (JSON array) ---
APPROVERS=[{"name":"First Approver","upn":"first.approver@lilly.com","oid":"<entra-oid>"},{"name":"Second Approver","upn":"second.approver@lilly.com","oid":"<entra-oid>"}]
APPROVAL_POLICY=all

# --- Reltio tenants ---
TENANT_ALLOWLIST=b0e8OhkxuytO3n3
TENANT_LABELS={"b0e8OhkxuytO3n3":"DEV B0"}

# --- Reltio API ---
RELTIO_AUTH_URL=https://auth.reltio.com/oauth/token
RELTIO_API_BASE=https://api.reltio.com
RELTIO_CLIENT_ID=<reltio-client-id>
RELTIO_CLIENT_SECRET=<reltio-client-secret>
RELTIO_CUSTOMER_ID=EliLilly

# --- AWS ---
REQUESTS_TABLE=<dynamodb-table-name>
NOTIFICATIONS_TABLE=<dynamodb-notifications-table>
ATTACHMENTS_BUCKET=<s3-bucket-name>

# --- Email notifications (SES) ---
NOTIFY_SENDER=no-reply@yourdomain.com
APP_URL=https://reltio-access.lilly.com

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5500

# --- Roles matrix ---
# Either a local path or an S3 URI:
ROLES_MATRIX_LOCAL_PATH=roles_matrix.sample.json
# ROLES_MATRIX_S3_URI=s3://bucket/roles_matrix.json

# --- Misc ---
LOG_LEVEL=INFO
